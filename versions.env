# Conjunto de versões testado ponta a ponta (D05, RNF-26). Uma tag deste repositório = "um sistema que funciona".
# Avança por PR (Dependabot/manual) e só passa se o teste ponta a ponta passar.
# ATENÇÃO (M0): `edge` é provisório, só vale até existirem releases; troque por X.Y.Z fixos.
BACKEND_VERSION=edge
FRONT_VERSION=edge
# Versão major do PostgreSQL (PD11). Na 18+, o volume é montado em /var/lib/postgresql.
POSTGRES_MAJOR=18
CADDY_VERSION=2.10
