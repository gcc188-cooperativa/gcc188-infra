// Coleta logs JSON dos contêineres do projeto e envia ao Loki; `correlation_id` vira metadado estruturado.
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "cooperativa" {
  targets = discovery.docker.containers.targets
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "cooperativa"
    action        = "keep"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "cooperativa" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.cooperativa.output
  forward_to = [loki.process.json.receiver]
}

loki.process "json" {
  stage.json {
    expressions = { level = "level", correlation_id = "correlation_id" }
  }
  stage.labels {
    values = { level = "" }
  }
  stage.structured_metadata {
    values = { correlation_id = "" }
  }
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint { url = "http://loki:3100/loki/api/v1/push" }
}
