# Variáveis NÃO secretas. Copie para .env (scripts/init-env.sh faz isso). Secrets ficam em secrets/.
# Organização no GitHub que publica as imagens em ghcr.io (PD01), em minúsculas.
GHCR_OWNER=org
# Perfis do Compose. `local-db` liga o PostgreSQL e o backup locais (desative para banco gerenciado).
COMPOSE_PROFILES=local-db
# Perfil opcional de logs: COMPOSE_PROFILES=local-db,observability

# --- Aplicação ---
SPRING_PROFILES_ACTIVE=prod
APP_TIMEZONE=America/Sao_Paulo
# URL JDBC; para banco remoto use sslmode=verify-full e desative o perfil local-db.
DB_URL=jdbc:postgresql://db:5432/cooperativa?sslmode=disable
DB_NAME=cooperativa
# false somente em dev sem TLS.
APP_AUTH_COOKIE_SECURE=true

# --- Produção (compose.prod.yaml) ---
APP_DOMAIN=cooperativa.example.com
ACME_EMAIL=admin@example.com
# Para testar a emissão sem estourar limites, use o ambiente de homologação do Let's Encrypt:
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# --- Limites (ambiente de referência do RNF-10: backend 1 CPU/1 GiB, PostgreSQL 1 GiB) ---
BACKEND_CPUS=1.0
BACKEND_MEM=1g
DB_CPUS=1.0
DB_MEM=1g

# --- Backup ---
BACKUP_HOUR=02
# Cópia externa opcional (rclone). Ex.: BACKUP_RCLONE_REMOTE=s3:meu-bucket/cooperativa
BACKUP_RCLONE_REMOTE=
